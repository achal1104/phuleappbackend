# --- Required ---
DATABASE_URL=postgres://phule:CHANGE_ME@localhost:5432/phule_command
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS
# --- Server ---
PORT=3000
CORS_ORIGINS=*
UPLOAD_DIR=./uploads
# --- Sessions ---
ACCESS_TTL=15m
REFRESH_TTL_DAYS=5
# --- Push notifications (Firebase Cloud Messaging) ---
# Paste the whole service-account JSON on one line. Without it, push is disabled (sockets + in-app inbox still work).
FIREBASE_SERVICE_ACCOUNT_JSON=
# --- Limits / tuning ---
RATE_LIMIT=300            # requests per minute per logged-in user
AUTH_IP_LIMIT=200         # login/register/refresh per minute per IP (venue Wi-Fi shares one IP)
LOGIN_MAX_FAILS=8         # failures before a 5-minute account lock
DB_POOL=30
IMPORT_DEFAULT_PASSWORD=  # used by CSV import when a row has no password
# --- First admin (used only by `npm run seed:admin`) ---
ADMIN_NAME=Festival Super Admin
ADMIN_PHONE=+919999999999
ADMIN_PASSWORD=CHANGE_ME_MIN_10_CHARS
